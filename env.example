# LEGACY docker-compose.yml template; not the new isolated release profile.
# New release: see deployment/release/README.md. prepare reads only CHAT_API_KEY,
# EMBEDDINGS_API_KEY, RERANK_API_KEY and TAVILY_API_KEY from a private .env;
# it fixes the reviewed BGE profile and generates a fresh database password/JWT.
# Never copy this legacy collection/model configuration into the release runtime.

# Chat LLM: keep the existing DeepSeek official API configuration.
# Copy the current MODEL_NAMES unchanged; this example does not switch models.
CHAT_API_KEY=
MODEL_PROVIDER=openai
MODEL_NAMES=["deepseek-v4-flash"]
MODEL_BASE_URL=https://api.deepseek.com

APP_TIMEZONE=Asia/Shanghai
TAVILY_API_KEY=

# Embedding: independent credentials and adapter, never the Chat key/provider.
# Keep the current model and endpoint until a separate model/collection migration.
EMBEDDINGS_API_KEY=
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL_NAME=text-embedding-3-large
EMBEDDINGS_BASE_URL=

# Reranker: defaults preserve the existing protocol and model.
# Set /rerank only when the chosen service explicitly requires that path.
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL_NAME=qwen3-rerank
RERANK_PATH=/reranks

# Optional legacy key: fallback only for https://dashscope.aliyuncs.com[:443].
# Embedding also requires EMBEDDINGS_PROVIDER=openai for this fallback.
# Independent keys take precedence. Other endpoints require their own keys.
DASHSCOPE_API_KEY=

# Auth and tokens

TOKEN_BEARER_URL=/api/v1/auth/login
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINS=1500
REFRESH_TOKEN_EXPIRY_DAYS=1

# Database and vector store

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test
POSTGRES_DATABASE=langgraph_db
PGVECTOR_COLLECTION_NAME=my_collection

# Frontend

BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1

# Document uploads only: connect/read inactivity timeouts in seconds.
# A timeout does not cancel backend indexing. Refresh status before retrying.
DOCUMENT_UPLOAD_CONNECT_TIMEOUT=10
DOCUMENT_UPLOAD_READ_TIMEOUT=300
